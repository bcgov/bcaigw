{
    "openapi": "3.0.0",
    "info": {
        "title": "BC AI Gateway API",
        "description": "OpenAI-compatible gateway invocation API for the BC AI Gateway.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/gateway",
            "description": "Gateway invocation API base path."
        }
    ],
    "paths": {
        "/v1/models": {
            "get": {
                "tags": [
                    "Gateway"
                ],
                "summary": "List the models this application may invoke.",
                "description": "OpenAI-compatible list of the models this application may invoke.",
                "operationId": "adeb41339342d429ad1ab6576b03a75a",
                "responses": {
                    "200": {
                        "description": "List of available models."
                    }
                }
            }
        },
        "/v1/chat/completions": {
            "post": {
                "tags": [
                    "Gateway"
                ],
                "summary": "Create an OpenAI-compatible chat completion.",
                "description": "OpenAI-compatible chat completion. Authorizes the call, forwards it to the\r\nresolved upstream target, records telemetry, and returns the reply.",
                "operationId": "c986894594c8f967fdabf98f0dd6fbb5",
                "responses": {
                    "200": {
                        "description": "Chat completion result."
                    }
                }
            }
        },
        "/v1/images/generations": {
            "post": {
                "tags": [
                    "Gateway"
                ],
                "summary": "Create an OpenAI-compatible image generation.",
                "description": "OpenAI-compatible image generation. Authorizes the call against the\r\nmodel's image_generation capability, forwards it to the resolved upstream\r\ntarget and returns the generated image(s).",
                "operationId": "4a492c7cd7ea03d3fdbe4b649e415a52",
                "responses": {
                    "200": {
                        "description": "Generated image(s)."
                    }
                }
            }
        },
        "/v1/embeddings": {
            "post": {
                "tags": [
                    "Gateway"
                ],
                "summary": "Create OpenAI-compatible embeddings.",
                "description": "OpenAI-compatible embeddings. Authorizes the call against the model's\r\nembeddings capability, forwards the input to the resolved upstream target\r\nand returns the embedding vectors.",
                "operationId": "a9f2cc8624becbde0f8afa207f29f2fd",
                "responses": {
                    "200": {
                        "description": "Embedding vectors."
                    }
                }
            }
        },
        "/v1/rerank": {
            "post": {
                "tags": [
                    "Gateway"
                ],
                "summary": "Rerank documents against a query.",
                "description": "Reranks a set of documents against a query. Reranking uses Bedrock's\r\ndedicated rerank API (not chat/converse), so it is exposed on its own\r\nendpoint and authorized against the model's rerank capability.",
                "operationId": "a882f71a5fcc906801c4e15f4f989d82",
                "responses": {
                    "200": {
                        "description": "Ranked documents."
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Gateway",
            "description": "Gateway"
        }
    ]
}