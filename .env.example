APP_NAME="BC AI Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Vancouver
APP_URL=http://localhost:8030

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_CA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=bcaigw_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.gov.bc.ca"
MAIL_FROM_NAME="${APP_NAME}"

# BC Gov Common Hosted Single Sign-On (CSS). Variable names match PDEX so one
# CSS integration and one set of platform secrets can serve both applications.
# Per-environment auth server URLs:
#   DEV   https://dev.loginproxy.gov.bc.ca/auth
#   TEST  https://test.loginproxy.gov.bc.ca/auth
#   PROD  https://loginproxy.gov.bc.ca/auth
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=standard
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Must byte-for-byte match a redirect URI registered on the CSS integration.
KEYCLOAK_REDIRECT_URI="${APP_URL}/applogin"
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="${APP_URL}"
KEYCLOAK_ENCRYPTION_ALGORITHM=RS256
KEYCLOAK_VERSION=26.0.0
# PDEX sends azureidir for government staff sign-in.
KEYCLOAK_IDP_HINT=azureidir
KEYCLOAK_IDENTITY_PROVIDER_CLAIM=identity_provider
# Comma separated allowlist of trusted identity_provider claim values.
KEYCLOAK_IDENTITY_PROVIDER_VALUES=idir,azureidir
KEYCLOAK_IDIR_GUID_CLAIM=idir_user_guid
KEYCLOAK_IDIR_USERNAME_CLAIM=idir_username
KEYCLOAK_TRANSACTION_TTL=300
KEYCLOAK_JWKS_CACHE_SECONDS=3600
KEYCLOAK_HTTP_TIMEOUT=5

MACHINE_AUTH_ISSUER="${APP_URL}"
MACHINE_AUTH_TOKEN_TTL=300
MACHINE_AUTH_TOKEN_RATE_LIMIT=30
MACHINE_AUTH_LAST_USED_INTERVAL=60
MACHINE_AUTH_ROTATION_OVERLAP=300
MACHINE_AUTH_MAX_ROTATION_OVERLAP=3600
MACHINE_AUTH_CLIENT_CACHE_BUFFER=60
MACHINE_AUTH_ARGON_MEMORY=65536
MACHINE_AUTH_ARGON_TIME=4
MACHINE_AUTH_ARGON_THREADS=1

# API Directory bearer token validation for the gateway invoke API (/api/gateway).
# The token is issued by the API Directory to the application's api_directory_client_id;
# BCAIGW validates its signature against the issuer JWKS and matches APP_API_AUDIENCE.
APP_API_TOKEN_ENDPOINT=
APP_API_AUDIENCE=
# Optional overrides; issuer and JWKS URI are derived from APP_API_TOKEN_ENDPOINT when unset.
APP_API_ISSUER=
APP_API_JWKS_URI=
APP_API_JWKS_CACHE=3600
APP_API_JWKS_LEEWAY=60

MODEL_CONTROL_ALLOW_ENCRYPTED_FALLBACK=false
MODEL_CONTROL_ALLOWED_HOSTS=
MODEL_CONTROL_ALLOW_PRIVATE_DEV_ENDPOINTS=false
MODEL_CONTROL_ALLOW_HTTP_DEV_ENDPOINTS=false

GATEWAY_MAX_PAYLOAD_BYTES=1048576
GATEWAY_MAX_MESSAGES=128
GATEWAY_MAX_INPUTS=128
GATEWAY_MAX_CONTENT_PARTS=64
GATEWAY_MAX_TEXT_CHARACTERS=200000
GATEWAY_MAX_IMAGE_URL_CHARACTERS=2048
GATEWAY_MAX_METADATA_ENTRIES=16
GATEWAY_MAX_EMBEDDING_DIMENSIONS=3072
GATEWAY_MAX_CONCURRENCY=20
GATEWAY_SAFE_CONNECT_RETRIES=1
GATEWAY_CONNECT_TIMEOUT=5
GATEWAY_FIRST_BYTE_TIMEOUT=15
GATEWAY_IDLE_TIMEOUT=30
GATEWAY_MAX_STREAM_EVENT_BYTES=262144
GATEWAY_SECRET_DIRECTORY=/run/secrets
GATEWAY_AZURE_API_VERSION=2024-10-21
QUOTA_RESERVATION_TIMEOUT=300
QUOTA_RECOVERY_BATCH_SIZE=100

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST="${APP_URL}"

VITE_APP_NAME="${APP_NAME}"

# --- Telemetry & content retention ---------------------------------------
# Operator-level kill switch. Can only reduce capture; never enables capture
# for an application that has turned prompt/response retention off.
TELEMETRY_CONTENT_CAPTURE_ENABLED=true
TELEMETRY_MAX_REQUEST_BYTES=262144
TELEMETRY_MAX_RESPONSE_BYTES=262144
TELEMETRY_MAX_STREAM_CHUNKS=512
TELEMETRY_PAGE_SIZE=25
TELEMETRY_EXPORT_MAX_ROWS=10000
TELEMETRY_ROLLUP_LOOKBACK_DAYS=3
TELEMETRY_SUMMARY_MAX_DAYS=92
TELEMETRY_DELETION_MAX_SELECTED=500
TELEMETRY_DELETION_MAX_RANGE_DAYS=366

# Envelope encryption keyring for retained prompts/responses.
# APP_KEY is rejected as content key material on purpose. Generate keys with
#   php artisan telemetry:content-key-generate
# Supply the keyring inline OR via a platform secret reference:
#   BCAIGW_CONTENT_KEYRING_REFERENCE=env:BCAIGW_CONTENT_KEYRING_JSON
#   BCAIGW_CONTENT_KEYRING_REFERENCE=file:content-keyring
BCAIGW_CONTENT_KEY_ID=
BCAIGW_CONTENT_KEYRING=
BCAIGW_CONTENT_KEYRING_REFERENCE=

# Prometheus/OpenTelemetry-compatible scrape endpoint at GET /metrics.
TELEMETRY_METRICS_ENABLED=true
TELEMETRY_METRICS_MAX_SERIES=2000
TELEMETRY_METRICS_TOKEN=

# Structured telemetry log channel (set to "null" to disable JSON call logs).
LOG_TELEMETRY_CHANNEL=telemetry
